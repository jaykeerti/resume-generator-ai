# Supabase Configuration
# For LOCAL development: Use http://localhost:54321 (run `npm run supabase:start` first)
#   - Get keys from the output of `npm run supabase:start`
# For REMOTE/Production: Use https://xxxxx.supabase.co
#   - Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Explicitly set environment (auto-detected from URL if not set)
# SUPABASE_ENV=local

# OpenAI API (for job description parsing and resume tailoring)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Stripe (for Phase 6 - Payments)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
